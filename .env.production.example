# Documentation only. Copy values into the protected Portainer environment;
# do not deploy this file and never place real secret values in Git.
TIME_TL_PRODUCTION_IMAGE=registry.example/time-tl@sha256:<64-lowercase-hex>
TIME_TL_POSTGRES_IMAGE=postgres@sha256:<64-lowercase-hex>
TIME_TL_NODE_EXPORTER_IMAGE=quay.io/prometheus/node-exporter@sha256:<64-lowercase-hex>
TIME_TL_RELEASE_ATTESTATION_DIR=/operator/controlled/time-tl-release
OWNER_CONFIG_REVISION=<positive-integer>

DATABASE_URL=<protected-postgresql+asyncpg-url>
POSTGRES_DB=<protected-value>
POSTGRES_USER=<protected-value>
POSTGRES_PASSWORD=<protected-value>
OWNER_TELEGRAM_FERNET_KEY=<protected-value>
OWNER_ALERTS_FERNET_KEY=<protected-value>
LESSON_LINK_FERNET_KEY=<protected-value>
ADMIN_IP_HASH_KEY=<protected-value>
ADMIN_TRUSTED_PROXY_CIDRS=<verified-proxy-cidr-list>

ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=8081
LOG_LEVEL=INFO
TZ=Europe/Kyiv
ALERT_STALE_AFTER_SECONDS=120

# Fail-closed public-release monitoring thresholds. The verifier checks signed
# numeric evidence from the external off-host collector before activation/canary.
MONITOR_PROVIDER_FRESHNESS_HOLD_SECONDS=120
MONITOR_HEARTBEAT_HOLD_SECONDS=90
MONITOR_CONTAINER_RESTART_HOLD_COUNT=1
MONITOR_OUTBOX_OLDEST_HOLD_SECONDS=60
MONITOR_OUTBOX_OPEN_HOLD_COUNT=100
MONITOR_OUTBOX_DEAD_HOLD_COUNT=1
MONITOR_OUTBOX_RETRY_HOLD_COUNT=1
MONITOR_DISK_FREE_HOLD_PERCENT=15
MONITOR_MEMORY_AVAILABLE_HOLD_PERCENT=10
MONITOR_BACKUP_MAX_AGE_SECONDS=86400
MONITOR_TLS_MIN_REMAINING_DAYS=14
