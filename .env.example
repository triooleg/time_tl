# Copy to .env only for local Compose. Never commit the populated file.
TIME_TL_ENV=simulation
LOG_LEVEL=INFO
TZ=Europe/Kyiv

# Fake is allowed only in local/simulation. Production must use alerts.in.ua.
ALERT_PROVIDER=fake
ALERTS_IN_UA_TOKEN=
ALERT_POLL_INTERVAL_SECONDS=15
# Hard local limiter: at most 5/minute with bucket capacity 1 (no burst).
ALERT_RATE_LIMIT_PER_MINUTE=5
ALERT_RATE_LIMIT_BURST=1
ALERT_STALE_AFTER_SECONDS=120

# Disabled keeps local scaffolding from contacting Telegram.
TELEGRAM_TRANSPORT=disabled
TELEGRAM_BOT_TOKEN=
# Stable Fernet key; generate once, store as a Portainer secret, never rotate casually.
LESSON_LINK_FERNET_KEY=
# Required for live transport in staging; comma-separated numeric chat IDs.
# Bot runs as one replica; restart invalidates pending confirmations and requires reconfirmation.
TEST_CHAT_ALLOWLIST=

# Manual personal homework. Keep disabled until its own reviewed release is approved.
# OCR/image digitization and Moiashkola are not part of this feature slice.
HOMEWORK_ENABLED=false

POSTGRES_DB=time_tl
POSTGRES_USER=time_tl
POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode reserved characters in the password used in this URL.
DATABASE_URL=postgresql+asyncpg://time_tl:replace-with-a-long-random-password@postgres:5432/time_tl

HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
RUNTIME_STATE_DIR=/var/lib/time-tl-runtime
SCHEDULE_WORKER_INTERVAL_SECONDS=30
SENDER_WORKER_INTERVAL_SECONDS=2
SENDER_MESSAGES_PER_SECOND=20
# Bounds Telegram I/O while final policy rows are locked (must be <=10 seconds).
SENDER_TRANSPORT_TIMEOUT_SECONDS=8

# Foundation-only escape hatch. It is rejected in staging/production.
ALLOW_SCAFFOLD_SERVICES=true

# Owner panel local/simulation backend. Production must use a reviewed PostgreSQL backend.
ADMIN_BACKEND=local_sqlite
# Stable random secret of at least 32 bytes; never expose it to bot/worker containers.
ADMIN_IP_HASH_KEY=
# Bootstrap-only key used to encrypt bot/provider tokens entered in the owner panel.
# Generate once with Fernet.generate_key(), store in Portainer, and do not rotate casually.
# Two independent stable Fernet keys; never reuse one value for both.
OWNER_TELEGRAM_FERNET_KEY=
OWNER_ALERTS_FERNET_KEY=
# environment = legacy env tokens; database = consume only an operator-activated panel version.
OWNER_CONFIG_SOURCE=environment
# Internal-only node_exporter endpoint; never expose port 9100 publicly.
HOST_METRICS_URL=http://node-exporter:9100/metrics
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8081
ADMIN_STATE_DIR=/var/lib/time-tl-admin
# false is allowed only for local/simulation HTTP. Use true behind HTTPS.
ADMIN_COOKIE_SECURE=false
# Empty means forwarding headers are ignored. Set only the exact reverse-proxy CIDR(s).
ADMIN_TRUSTED_PROXY_CIDRS=
# One-time credential file shared with admin-web; plaintext is deleted after use/expiry.
ADMIN_BOOTSTRAP_ARTIFACT_PATH=/var/lib/time-tl-admin/admin-bootstrap.txt
